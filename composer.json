{
  "name": "shahin-ilderemi/orchestrix-forms",
  "description": "WordPress-native low-code forms, data, and workflow platform.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.12",
    "php-stubs/wordpress-stubs": "^6.8",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "Orchestrix\\Forms\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Orchestrix\\Forms\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "lint": "php scripts/lint.php",
    "standards": "phpcs --standard=phpcs.xml.dist",
    "phpunit": "phpunit --configuration phpunit.xml.dist",
    "test": ["@lint", "@standards", "@phpunit", "php tests/run.php"],
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "package": "php scripts/package.php",
    "verify": ["@test", "@analyse", "npm run verify"],
    "audit:dependencies": ["@composer audit --locked", "npm audit --audit-level=high"],
    "verify:online": ["@verify", "@audit:dependencies"]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false,
    "cache-dir": ".composer-cache"
  }
}
