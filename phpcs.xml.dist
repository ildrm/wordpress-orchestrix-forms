<?xml version="1.0"?>
<ruleset name="Orchestrix Forms">
  <description>Project PHP coding-standard gate.</description>
  <file>orchestrix-forms.php</file>
  <file>uninstall.php</file>
  <file>src</file>
  <file>scripts</file>
  <file>tests</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/build/*</exclude-pattern>
  <exclude-pattern>*/tests/php-stubs.php</exclude-pattern>
  <arg name="extensions" value="php"/>
  <arg name="parallel" value="4"/>
  <arg name="warning-severity" value="0"/>
  <rule ref="PSR12"/>
</ruleset>
